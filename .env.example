# ==============================================================================
# CONFIGURATION SUPABASE POUR ABIDJAN LOCATION
# ==============================================================================

# URL de votre projet Supabase (ex: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Clé publique anonyme Supabase (Anon Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Clé de rôle de service Supabase (Secret / Backend uniquement - Ne pas exposer au client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# URL de base de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# CONFIGURATION PAIEMENT CINETPAY (MOBILE MONEY)
# ==============================================================================
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com
SUBSCRIPTION_PRICE_XOF=3000
SUBSCRIPTION_PERIOD_DAYS=30
